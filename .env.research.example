# Set these as config vars on the NEW Heroku backend app, not on the old app.
# This is a reference template; the workflow reads config vars from Heroku.
ENV=production
# sequential_approval, sequential, independent_approval, or independent
STUDY_ACCESS_MODE=sequential_approval
MONGO_URL=mongodb+srv://<research-user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGO_DB=mep_all_variants_research
JWT_SECRET=<generate-a-fresh-random-secret-at-least-32-characters>
JWT_EXPIRES_MIN=180
COOKIE_NAME=mep_research_session
COOKIE_SECURE=true
COOKIE_SAMESITE=Lax
# Leave COOKIE_DOMAIN unset. Browsers use the same-origin frontend proxy.
# Use the actual new frontend URL, including Heroku's generated suffix.
FRONTEND_ORIGIN=https://<new-frontend-app>-<identifier>.herokuapp.com
UF_OPENAI_API_KEY=<key-for-your-accessible-provider>
UF_OPENAI_BASE_URL=https://<provider-api-host>/<api-prefix>
UF_OPENAI_API_MODEL=<model-supported-by-that-provider>
# Optional: leave unset to disable new-link discovery.
TAVILY_API_KEY=

# GitHub repository secrets (NOT Heroku config vars):
# HEROKU_API_KEY_RESEARCH: token with access to the new apps and read access to
#   the existing backend's config vars (used only for isolation checks).
# HEROKU_APP_BACKEND_RESEARCH: NEW backend app name, without https:// or a domain.
# HEROKU_APP_FRONTEND_RESEARCH: NEW frontend app name, without https:// or a domain.
# Existing HEROKU_APP_BACKEND / HEROKU_APP_FRONTEND secrets stay unchanged.
# No BACKEND_URL_RESEARCH secret is needed: the workflow discovers the URL.
